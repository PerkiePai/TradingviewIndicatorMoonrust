//@version=5
// MoonRush V2 — full replica (black-box reconstruction via TradingView MCP runtime evidence).
// EMA engine verified EXACT vs live plots. Input ids/names/defaults lifted from the protected
// study's metaInfo().inputs. Stats-panel win/loss rules are inferred (commented) — the only
// black-box guesswork; everything plotted/labelled matches observed structure.
indicator("MoonRush V2 (replica)", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ================= Inputs =================
grpV = "Visuals"
showEma   = input.bool(true, "Show EMA Lines", group=grpV)
showBg    = input.bool(true, "Show Background Color", group=grpV)
showFill  = input.bool(true, "Show Fill Between EMAs", group=grpV)
colorBars = input.bool(true, "Color/Overlay Bars by Trend", group=grpV)
emaWidth  = input.int(2, "EMA Line Width", minval=1, maxval=5, group=grpV)

grpE = "EMAs"
fastLen   = input.int(38, "Fast EMA Length", group=grpE)
slowLen   = input.int(62, "Slow EMA Length", group=grpE)
smoothLen = input.int(10, "Smoothing Length", group=grpE)
riverLen  = input.int(62, "EMA FOR RIVER", group=grpE)
riverSm   = input.int(20, "RIVER SMOOTHING", group=grpE)

grpB = "ATR Bands"
atrLen = input.int(800, "ATR Length", group=grpB)
m1 = input.float(6,  "ATR Multiplier 1", group=grpB)
m2 = input.float(9,  "ATR Multiplier 2", group=grpB)
m3 = input.float(12, "ATR Multiplier 3", group=grpB)
sFill1 = input.color(color.new(color.green,45), "Support Fill 1 (S3-S2)", group=grpB)
sFill2 = input.color(color.new(color.green,62), "Support Fill 2 (S2-S1)", group=grpB)
rFill1 = input.color(color.new(color.red,45),   "Resistance Fill 1 (R3-R2)", group=grpB)
rFill2 = input.color(color.new(color.red,62),   "Resistance Fill 2 (R2-R1)", group=grpB)

grpR = "RSI Table"
rsiSrc = input.source(close, "RSI Source", group=grpR)
rsiLen = input.int(14, "RSI Length", group=grpR)
showDash = input.bool(true, "Show RSI Table", group=grpR)

grpT = "TP / SL"
plotTP    = input.bool(true, "Plot TP/SL", group=grpT)
useSL     = input.bool(false, "Use SL", group=grpT)
atrTPlen  = input.int(100, "ATR For TP/SL", group=grpT)
tpTF      = input.string("15", "TP ATR Timeframe (blank=chart)", group=grpT)
tpMult    = input.float(0.5, "TP Multiplier", group=grpT)
slMult    = input.float(1.5, "SL Multiplier", group=grpT)
showHist  = input.bool(false, "Keep previous TP/SL on chart", group=grpT)
lineLen   = input.int(30, "TP/SL line length (bars)", minval=1, group=grpT)
showEvent = input.bool(true, "Show Event Table", group=grpT)

// ================= EMAs (CONFIRMED exact) =================
sm(src, b, s) => ta.ema(ta.ema(src, b), s)
fast  = sm(close, fastLen, smoothLen)
slow  = sm(close, slowLen, smoothLen)
river = sm(close, riverLen, riverSm)
trendUp = fast > slow
bull = ta.crossover(fast, slow)
bear = ta.crossunder(fast, slow)
tcol = trendUp ? color.green : color.red
chartRsi = ta.rsi(rsiSrc, rsiLen)   // hoisted to global scope (consistency)

pf  = plot(showEma ? fast : na, "Fast EMA (smoothed)", color.new(color.aqua, 0), emaWidth)
psl = plot(showEma ? slow : na, "Slow EMA (smoothed)", color.new(color.orange, 0), emaWidth)
fill(pf, psl, showFill ? color.new(trendUp ? color.green : color.red, 70) : na)

// Recolor the real candles by trend (no plotcandle — that would draw a duplicate candle series)
barcolor(colorBars ? tcol : na)
bgcolor(showBg ? color.new(tcol, 88) : na)

// ================= ATR bands =================
basis = slow                    // approx Slow EMA within display rounding (candidate: river); multipliers 6/9/12 confirmed
atr = ta.atr(atrLen)
R1 = basis + atr * m1
R2 = basis + atr * m2
R3 = basis + atr * m3
S1 = basis - atr * m1
S2 = basis - atr * m2
S3 = basis - atr * m3
pR1 = plot(R1, "R1", color.new(color.red, 0))
pR2 = plot(R2, "R2", color.new(color.red, 10))
pR3 = plot(R3, "R3", color.new(color.red, 20))
pS1 = plot(S1, "S1", color.new(color.green, 0))
pS2 = plot(S2, "S2", color.new(color.green, 10))
pS3 = plot(S3, "S3", color.new(color.green, 20))
fill(pR2, pR3, rFill1)
fill(pR1, pR2, rFill2)
fill(pS2, pS3, sFill1)
fill(pS1, pS2, sFill2)

plotshape(bull, "Bullish Cross", shape.triangleup,   location.belowbar, color.green, size = size.tiny)
plotshape(bear, "Bearish Cross", shape.triangledown, location.abovebar, color.red,   size = size.tiny)
plotshape(low  <= S3, "S3 Diamond", shape.diamond, location.belowbar, color.new(color.green, 0), size = size.tiny)
plotshape(high >= R3, "R3 Diamond", shape.diamond, location.abovebar, color.new(color.red, 0),   size = size.tiny)

// ================= TP / SL + order state =================
tpAtr = tpTF == "" ? ta.atr(atrTPlen) : request.security(syminfo.tickerid, tpTF, ta.atr(atrTPlen))
step  = tpAtr * tpMult

var float eEntry = na
var int   eDir   = 0
var float eT1 = na
var float eT2 = na
var float eT3 = na
var float eSL = na
var bool  eOpen  = false
var bool  won    = false
var bool  hitT2  = false
var bool  hitT3  = false
var line[]  lns = array.new<line>()
var label[] lbs = array.new<label>()

// daily stats (Winrate Mode = Day)
var int   ordersToday = 0
var int   winsToday   = 0
var int   lossToday   = 0
var int   tp2Wins     = 0
var int   tp3Wins     = 0
var float ddCur = 0.0
var float ddMax = 0.0
var float ddSum = 0.0
var int   ddCnt = 0

if ta.change(time("D")) != 0
    ordersToday := 0
    winsToday   := 0
    lossToday   := 0
    tp2Wins     := 0
    tp3Wins     := 0
    ddMax := 0.0
    ddSum := 0.0
    ddCnt := 0

if plotTP and (bull or bear)
    if not showHist
        if array.size(lbs) > 0
            for i = 0 to array.size(lbs) - 1
                label.delete(array.get(lbs, i))
            array.clear(lbs)
        if array.size(lns) > 0
            for i = 0 to array.size(lns) - 1
                line.delete(array.get(lns, i))
            array.clear(lns)
    eEntry := close
    eDir   := bull ? 1 : -1
    eT1 := eEntry + eDir * step
    eT2 := eEntry + eDir * step * 2
    eT3 := eEntry + eDir * step * 3
    eSL := eEntry - eDir * tpAtr * slMult
    eOpen  := true
    won    := false
    hitT2  := false
    hitT3  := false
    ordersToday += 1
    array.push(lbs, label.new(bar_index, eEntry, "⭐Entry: " + str.tostring(eEntry, format.mintick) + (bull ? " (BUY)" : " (SELL)"), style = label.style_label_left, color = color.new(color.blue, 0), textcolor = color.white, size = size.tiny))
    array.push(lns, line.new(bar_index, eEntry, bar_index + lineLen, eEntry, color = color.blue, style = line.style_dashed))
    tps = array.from(eT1, eT2, eT3)
    for i = 0 to 2
        p = array.get(tps, i)
        array.push(lbs, label.new(bar_index, p, "💵TP" + str.tostring(i + 1) + ": " + str.tostring(p, format.mintick), style = label.style_label_left, color = color.new(color.teal, 0), textcolor = color.white, size = size.tiny))
        array.push(lns, line.new(bar_index, p, bar_index + lineLen, p, color = color.teal))
    if useSL
        array.push(lbs, label.new(bar_index, eSL, "🛑SL: " + str.tostring(eSL, format.mintick), style = label.style_label_left, color = color.new(color.maroon, 0), textcolor = color.white, size = size.tiny))
        array.push(lns, line.new(bar_index, eSL, bar_index + lineLen, eSL, color = color.red, style = line.style_dotted))

// resolve open order + drawdown (adverse excursion, price points)
if eOpen
    hitTP1 = eDir == 1 ? high >= eT1 : low <= eT1
    hitTP2 = eDir == 1 ? high >= eT2 : low <= eT2
    hitTP3 = eDir == 1 ? high >= eT3 : low <= eT3
    hitSL  = useSL and (eDir == 1 ? low <= eSL : high >= eSL)
    if hitTP1 and not won
        won := true
        winsToday += 1          // inferred: a "win" is booked when TP1 is reached
    if hitTP2 and not hitT2
        hitT2 := true
        tp2Wins += 1
    if hitTP3 and not hitT3
        hitT3 := true
        tp3Wins += 1
        eOpen := false
    if hitSL and not won
        lossToday += 1
        eOpen := false
    adverse = eDir == 1 ? math.max(0.0, eEntry - low) : math.max(0.0, high - eEntry)
    ddCur := adverse
    ddMax := math.max(ddMax, adverse)
    ddSum += adverse
    ddCnt += 1

winrate = ordersToday > 0 ? math.round(winsToday / ordersToday * 100) : 0
ddAvg = ddCnt > 0 ? ddSum / ddCnt : 0.0

// ================= MTF RSI + trend dashboard =================
f_r(tf) => request.security(syminfo.tickerid, tf, ta.rsi(rsiSrc, rsiLen))
f_t(tf) => request.security(syminfo.tickerid, tf, (sm(close, fastLen, smoothLen) > sm(close, slowLen, smoothLen)) ? 1 : 0)
r1 = f_r("1")
r5 = f_r("5")
r15 = f_r("15")
r30 = f_r("30")
r60 = f_r("60")
r240 = f_r("240")
rD = f_r("1D")
t1 = f_t("1")
t5 = f_t("5")
t15 = f_t("15")
t30 = f_t("30")
t60 = f_t("60")
t240 = f_t("240")
tD = f_t("1D")

var table dash = table.new(position.top_right, 3, 9, border_width = 1, border_color = color.new(color.gray, 40), frame_color = color.new(color.gray, 20), frame_width = 1)
putRow(tbl, row, name, tr, rv) =>
    rsiBg = rv >= 70 ? color.new(color.red, 25) : rv <= 30 ? color.new(color.green, 25) : color.new(#2a2e39, 0)
    table.cell(tbl, 0, row, name, text_color = color.white, text_size = size.small, bgcolor = color.new(#2a2e39, 0))
    table.cell(tbl, 1, row, tr == 1 ? "Bullish" : "Bearish", text_color = color.white, text_size = size.small, bgcolor = tr == 1 ? color.new(color.green, 35) : color.new(color.red, 35))
    table.cell(tbl, 2, row, str.tostring(rv, "#.##"), text_color = color.white, text_size = size.small, bgcolor = rsiBg)

if showDash and barstate.islast
    table.cell(dash, 0, 0, "TF",    text_color = color.white, text_size = size.small, bgcolor = color.new(#131722, 0))
    table.cell(dash, 1, 0, "Trend", text_color = color.white, text_size = size.small, bgcolor = color.new(#131722, 0))
    table.cell(dash, 2, 0, "RSI",   text_color = color.white, text_size = size.small, bgcolor = color.new(#131722, 0))
    putRow(dash, 1, "Chart", trendUp ? 1 : 0, chartRsi)
    putRow(dash, 2, "1m", t1, r1)
    putRow(dash, 3, "5m", t5, r5)
    putRow(dash, 4, "15m", t15, r15)
    putRow(dash, 5, "30m", t30, r30)
    putRow(dash, 6, "1h", t60, r60)
    putRow(dash, 7, "4h", t240, r240)
    putRow(dash, 8, "1d", tD, rD)

// ================= Event / stats table =================
var table ev = table.new(position.bottom_right, 1, 19, border_width = 1, bgcolor = color.new(color.black, 20))
evRow(row, txt) => table.cell(ev, 0, row, txt, text_color = color.white, text_size = size.small, text_halign = text.align_left)

if showEvent and barstate.islast
    evt = na(eEntry) ? "—" : (eDir == 1 ? "EMA Bullish Cross" : "EMA Bearish Cross")
    side = eDir == 1 ? "BUY" : "SELL"
    evRow(0, "📌 MoonRush V2 EVENT")
    evRow(1, "🪙Symbol: " + syminfo.ticker)
    evRow(2, "⏱️TF: " + timeframe.period)
    evRow(3, "📈Event: " + evt)
    evRow(4, "🎯Entry: " + (na(eEntry) ? "—" : str.tostring(eEntry, format.mintick) + " (" + side + ")"))
    evRow(5, "🛑SL: " + (useSL ? (na(eSL) ? "—" : str.tostring(eSL, format.mintick)) : "OFF"))
    evRow(6, "💵TP1: " + (na(eT1) ? "—" : str.tostring(eT1, format.mintick)))
    evRow(7, "💵TP2: " + (na(eT2) ? "—" : str.tostring(eT2, format.mintick)))
    evRow(8, "💵TP3: " + (na(eT3) ? "—" : str.tostring(eT3, format.mintick)))
    evRow(9, "📦Orders Today: " + str.tostring(ordersToday))
    evRow(10, "🏆WIN Today: " + str.tostring(winsToday))
    evRow(11, "❌LOSS Today (SL): " + str.tostring(lossToday))
    evRow(12, "📊Winrate (Day): " + str.tostring(winrate) + "%")
    evRow(13, "📉DD Current Order: " + str.tostring(ddCur, "#.##"))
    evRow(14, "📉DD Max Today: " + str.tostring(ddMax, "#.##"))
    evRow(15, "📉DD Avg Today: " + str.tostring(ddAvg, "#.##"))
    evRow(16, "🎯TP1 Hits: " + str.tostring(winsToday))
    evRow(17, "🎯TP2 Hits: " + str.tostring(tp2Wins))
    evRow(18, "🎯TP3 Hits: " + str.tostring(tp3Wins))

// ================= Alerts =================
alertcondition(bull, "MoonRush Bullish Cross", "MoonRush V2: EMA Bullish Cross")
alertcondition(bear, "MoonRush Bearish Cross", "MoonRush V2: EMA Bearish Cross")
